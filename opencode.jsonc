{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                // Ключ НЕ храним в git. Задай переменную окружения CONTEXT7_API_KEY
                // (системные переменные Windows или ~/.bashrc на VM).
                "Authorization": "{env:CONTEXT7_API_KEY}",
            },
            "enabled": true,
        },
    },
}
